class PlaylistEndpoint {
    var publicClient: HttpClient;
    var privateClient: HttpClient;
    var auth: AuthEndpoint;
    
    construct(this.publicClient, this.privateClient, this.auth) {
        print('📋 Initialisation de l\'endpoint Playlist');
    }
    
    fun get(id: String) -> Future {
        return Future((resolve, reject) {
            print('📋 Récupération de la playlist ID: ${id}');
            
            final url = '/playlist/${id}';
            
            this.publicClient.get(url).then((response) {
                if (response.statusCode == 200) {
                    try {
                        final data = response.toJson();
                        final playlist = this._mapPlaylistToSpotube(data);
                        print('✅ Playlist récupérée: ${playlist.name} (${playlist.totalTracks} titres)');
                        resolve(playlist);
                    } catch (e) {
                        print('❌ Erreur parsing playlist: ${e}');
                        reject('Erreur lors du parsing de la playlist: ${e}');
                    }
                } else {
                    print('❌ Playlist non trouvée: ${response.statusCode}');
                    reject('Playlist non trouvée');
                }
            }).catchError((error) {
                print('❌ Erreur réseau playlist: ${error}');
                reject(error.toString());
            });
        });
    }
    
    fun getTracks(id: String, offset: number = 0, limit: number = 50) -> Future {
        return Future((resolve, reject) {
            print('🎵 Récupération des titres de la playlist ${id}');
            
            final url = '/playlist/${id}/tracks?index=${offset}&limit=${limit}';
            
            this.publicClient.get(url).then((response) {
                if (response.statusCode == 200) {
                    try {
                        final data = response.toJson();
                        final tracks = [];
                        
                        if (data.data && data.data.isNotEmpty) {
                            for (track in data.data) {
                                tracks.add(this._mapTrackToSpotube(track));
                            }
                        }
                        
                        print('✅ ${tracks.length} titres récupérés pour la playlist ${id}');
                        resolve(tracks);
                    } catch (e) {
                        print('❌ Erreur parsing titres playlist: ${e}');
                        reject('Erreur lors du parsing des titres: ${e}');
                    }
                } else {
                    print('❌ Titres de la playlist non trouvés: ${response.statusCode}');
                    reject('Titres de la playlist non trouvés');
                }
            }).catchError((error) {
                print('❌ Erreur réseau titres playlist: ${error}');
                reject(error.toString());
            });
        });
    }
    
    fun _mapPlaylistToSpotube(deezerPlaylist: Map) -> Map {
        return {
            'id': deezerPlaylist.id?.toString() || '0',
            'name': deezerPlaylist.title || 'Playlist inconnue',
            'description': deezerPlaylist.description || '',
            'externalUri': deezerPlaylist.link || '',
            'images': deezerPlaylist.picture_medium ? [{
                'url': deezerPlaylist.picture_small || deezerPlaylist.picture_medium,
                'width': 64,
                'height': 64
            }, {
                'url': deezerPlaylist.picture_medium,
                'width': 300,
                'height': 300
            }, {
                'url': deezerPlaylist.picture_big || deezerPlaylist.picture_xl || deezerPlaylist.picture_medium,
                'width': 640,
                'height': 640
            }] : [],
            'owner': {
                'id': deezerPlaylist.creator?.id?.toString() || deezerPlaylist.user?.id?.toString() || '0',
                'name': deezerPlaylist.creator?.name || deezerPlaylist.user?.name || 'Utilisateur inconnu',
                'externalUri': deezerPlaylist.creator?.link || deezerPlaylist.user?.link || ''
            },
            'totalTracks': deezerPlaylist.nb_tracks || 0,
            'collaborative': false,
            'public': deezerPlaylist.public || false,
            'followers': deezerPlaylist.fans || 0
        };
    }
    
    fun _mapTrackToSpotube(deezerTrack: Map) -> Map {
        return {
            'id': deezerTrack.id?.toString() || '0',
            'name': deezerTrack.title || 'Titre inconnu',
            'externalUri': deezerTrack.link || '',
            'artists': [{
                'id': deezerTrack.artist?.id?.toString() || '0',
                'name': deezerTrack.artist?.name || 'Artiste inconnu',
                'externalUri': deezerTrack.artist?.link || ''
            }],
            'album': {
                'id': deezerTrack.album?.id?.toString() || '0',
                'name': deezerTrack.album?.title || 'Album inconnu',
                'externalUri': deezerTrack.album?.link || '',
                'images': deezerTrack.album?.cover_medium ? [{
                    'url': deezerTrack.album.cover_medium,
                    'width': 300,
                    'height': 300
                }] : []
            },
            'durationMs': (deezerTrack.duration || 0) * 1000,
            'explicit': deezerTrack.explicit_lyrics || false,
            'popularity': deezerTrack.rank || 0,
            'previewUrl': deezerTrack.preview || null,
            'addedAt': deezerTrack.time_add ? DateTime.fromMillisecondsSinceEpoch(deezerTrack.time_add * 1000).toIso8601String() : null
        };
    }
}
