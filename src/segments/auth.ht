import { LocalStorage, WebView } from 'spotube:api';

/**
 * Endpoint d'authentification pour Deezer ARL
 * Gère la récupération, validation et stockage de l'ARL
 */
class AuthEndpoint {
    var publicClient: HttpClient;
    var privateClient: HttpClient;
    var currentArl: String?;
    var isLoggedIn: bool = false;
    var userData: Map?;
    final authController: StreamController = StreamController.broadcast();
    
    get authStateStream -> Stream => this.authController.stream;
    
    construct(this.publicClient, this.privateClient) {
        print('🔐 Initialisation du système d\'authentification ARL');
        this._loadSavedCredentials();
    }
    
    /**
     * Vérifie si l'utilisateur est authentifié
     */
    fun isAuthenticated() -> bool {
        return this.isLoggedIn && this.currentArl != null && this.currentArl.length > 100;
    }
    
    /**
     * Lance le processus d'authentification via WebView
     */
    fun authenticate() -> Future {
        return Future((resolve, reject) {
            print('🌐 Ouverture de la WebView pour authentification ARL');
            
            WebView.open({
                url: 'https://www.deezer.com/login',
                title: 'Connexion Deezer - Récupération ARL',
                width: 700,
                height: 800,
                onMessage: (message) {
                    if (message.type == 'arl_provided') {
                        print('📥 ARL reçu, validation en cours...');
                        this._processArlLogin(message.arl).then((success) {
                            if (success) {
                                print('✅ Authentification ARL réussie');
                                resolve(true);
                            } else {
                                print('❌ ARL invalide ou expiré');
                                reject('ARL invalide ou expiré');
                            }
                        }).catchError((error) {
                            print('❌ Erreur lors de l\'authentification: ${error}');
                            reject(error.toString());
                        });
                    } else if (message.type == 'cancel') {
                        print('⏹️ Authentification annulée par l\'utilisateur');
                        reject('Authentification annulée par l\'utilisateur');
                    }
                },
                initialScript: '''
                    window.addEventListener('load', function() {
                        // Interface d'aide pour récupérer l'ARL
                        const helpDiv = document.createElement('div');
                        helpDiv.innerHTML = `
                            <div style="position: fixed; top: 20px; right: 20px; background: linear-gradient(135deg, #ff6600, #ff9900); color: white; padding: 25px; border-radius: 15px; z-index: 10000; max-width: 400px; box-shadow: 0 8px 25px rgba(0,0,0,0.3); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; backdrop-filter: blur(10px);">
                                <div style="display: flex; align-items: center; margin-bottom: 15px;">
                                    <span style="font-size: 24px; margin-right: 10px;">🔐</span>
                                    <h3 style="margin: 0; font-size: 18px; font-weight: 600;">Récupération ARL Deezer</h3>
                                </div>
                                <ol style="font-size: 14px; line-height: 1.6; margin: 0 0 20px 0; padding-left: 20px;">
                                    <li><strong>Connectez-vous</strong> à Deezer ci-dessous</li>
                                    <li>Ouvrez les <strong>outils développeur</strong> (F12)</li>
                                    <li>Onglet <strong>Application</strong> → <strong>Cookies</strong> → <strong>deezer.com</strong></li>
                                    <li>Cherchez le cookie <strong style="color: #ffdd00;">"arl"</strong></li>
                                    <li>Copiez sa <strong>valeur complète</strong></li>
                                    <li>Collez-la dans le champ ci-dessous :</li>
                                </ol>
                                <div style="background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; margin-bottom: 15px;">
                                    <textarea id="arlInput" placeholder="Collez votre ARL ici...

Format attendu : une longue chaîne de caractères (~192 caractères)" style="width: 100%; height: 80px; padding: 12px; border: 2px solid rgba(255,255,255,0.3); border-radius: 8px; font-size: 13px; box-sizing: border-box; background: rgba(255,255,255,0.9); color: #333; font-family: monospace; resize: vertical;"></textarea>
                                    <div style="font-size: 12px; color: rgba(255,255,255,0.8); margin-top: 8px;">
                                        💡 L'ARL fait généralement ~192 caractères et commence par des chiffres
                                    </div>
                                </div>
                                <div style="display: flex; gap: 12px;">
                                    <button onclick="submitArl()" style="flex: 1; background: linear-gradient(135deg, #28a745, #20c997); color: white; padding: 12px; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s;">✅ Valider ARL</button>
                                    <button onclick="cancelAuth()" style="flex: 1; background: linear-gradient(135deg, #6c757d, #5a6268); color: white; padding: 12px; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s;">❌ Annuler</button>
                                </div>
                                <div style="font-size: 11px; color: rgba(255,255,255,0.7); margin-top: 12px; text-align: center;">
                                    🔒 Votre ARL est stocké localement et sécurisé
                                </div>
                            </div>
                        `;
                        document.body.appendChild(helpDiv);
                        
                        // Fonctions globales
                        window.submitArl = function() {
                            const arl = document.getElementById('arlInput').value.trim();
                            if (arl && arl.length > 100) {
                                // Animation de validation
                                const button = document.querySelector('button[onclick="submitArl()"]');
                                button.innerHTML = '⏳ Validation...';
                                button.disabled = true;
                                
                                setTimeout(() => {
                                    window.postMessage({type: 'arl_provided', arl: arl});
                                }, 500);
                            } else {
                                alert('⚠️ Veuillez entrer un ARL valide (>100 caractères)\\n\\nL\'ARL doit être une longue chaîne de caractères récupérée depuis les cookies de Deezer.');
                                document.getElementById('arlInput').focus();
                            }
                        };
                        
                        window.cancelAuth = function() {
                            window.postMessage({type: 'cancel'});
                        };
                        
                        // Validation en temps réel
                        document.getElementById('arlInput').addEventListener('input', function(e) {
                            const arl = e.target.value.trim();
                            const button = document.querySelector('button[onclick="submitArl()"]');
                            if (arl.length > 100) {
                                e.target.style.borderColor = '#28a745';
                                button.style.opacity = '1';
                            } else {
                                e.target.style.borderColor = '#ffc107';
                                button.style.opacity = '0.7';
                            }
                        });
                    });
                '''
            });
        });
    }
    
    /**
     * Traite la connexion via ARL
     */
    fun _processArlLogin(arl: String) -> Future {
        return Future((resolve, reject) {
            this._validateArl(arl).then((userData) {
                if (userData != null) {
                    this.currentArl = arl;
                    this.userData = userData;
                    this.isLoggedIn = true;
                    
                    // Sauvegarde sécurisée
                    LocalStorage.setItem('deezer_arl', arl);
                    LocalStorage.setItem('deezer_user_data', userData.toJson());
                    LocalStorage.setItem('deezer_arl_timestamp', DateTime.now().millisecondsSinceEpoch.toString());
                    
                    this.authController.add({
                        'type': 'login_success',
                        'user': userData
                    }.toJson());
                    
                    final userName = userData.USER?.BLOG_NAME || 'Utilisateur';
                    print('✅ Authentification Deezer réussie pour: ${userName}');
                    resolve(true);
                } else {
                    print('❌ Validation ARL échouée');
                    resolve(false);
                }
            }).catchError((error) {
                print('❌ Erreur validation ARL: ${error}');
                reject(error);
            });
        });
    }
    
    /**
     * Valide l'ARL auprès de l'API Deezer
     */
    fun _validateArl(arl: String) -> Future {
        return Future((resolve, reject) {
            final headers = {
                'Cookie': 'arl=${arl}; sid=fr'
            };
            
            this.privateClient.get('/ajax/gw-light.php?method=deezer.getUserData&input=3&api_version=1.0&api_token=', 
                headers: headers
            ).then((response) {
                if (response.statusCode == 200) {
                    try {
                        final data = response.toJson();
                        if (data.results && data.results.USER && data.results.USER.USER_ID && data.results.USER.USER_ID > 0) {
                            print('✅ ARL validé avec succès');
                            resolve(data.results);
                        } else {
                            print('❌ ARL invalide - pas de données utilisateur');
                            resolve(null);
                        }
                    } catch (e) {
                        print('❌ Erreur parsing réponse validation: ${e}');
                        resolve(null);
                    }
                } else {
                    print('❌ Erreur HTTP validation ARL: ${response.statusCode}');
                    resolve(null);
                }
            }).catchError((error) {
                print('❌ Erreur réseau validation ARL: ${error}');
                resolve(null);
            });
        });
    }
    
    /**
     * Charge les identifiants sauvegardés au démarrage
     */
    fun _loadSavedCredentials() {
        final savedArl = LocalStorage.getItem('deezer_arl');
        final timestamp = LocalStorage.getItem('deezer_arl_timestamp');
        
        if (savedArl != null && savedArl.length > 100) {
            // Vérifier si l'ARL n'est pas trop ancien (3 mois = 90 jours)
            final now = DateTime.now().millisecondsSinceEpoch;
            final savedTime = timestamp != null ? int.tryParse(timestamp) : now;
            final daysSinceLastAuth = (now - savedTime) / (1000 * 60 * 60 * 24);
            
            if (daysSinceLastAuth > 90) {
                print('⚠️ ARL sauvegardé trop ancien (${daysSinceLastAuth.round()} jours), nouvelle authentification requise');
                return;
            }
            
            print('🔄 Tentative de restauration de session ARL...');
            this._validateArl(savedArl).then((userData) {
                if (userData != null) {
                    this.currentArl = savedArl;
                    this.userData = userData;
                    this.isLoggedIn = true;
                    this.authController.add({
                        'type': 'session_restored',
                        'user': userData
                    }.toJson());
                    final userName = userData.USER?.BLOG_NAME || 'Utilisateur';
                    print('✅ Session Deezer restaurée automatiquement pour: ${userName}');
                } else {
                    print('❌ ARL sauvegardé invalide, suppression...');
                    this._clearSavedCredentials();
                }
            });
        }
    }
    
    /**
     * Déconnexion et nettoyage
     */
    fun logout() -> Future {
        return Future((resolve, reject) {
            print('🚪 Déconnexion Deezer...');
            this._clearSavedCredentials();
            
            this.authController.add({
                'type': 'logout'
            }.toJson());
            
            print('✅ Déconnexion Deezer effectuée');
            resolve(true);
        });
    }
    
    /**
     * Nettoie les identifiants sauvegardés
     */
    fun _clearSavedCredentials() {
        this.currentArl = null;
        this.userData = null;
        this.isLoggedIn = false;
        
        LocalStorage.removeItem('deezer_arl');
        LocalStorage.removeItem('deezer_user_data');
        LocalStorage.removeItem('deezer_arl_timestamp');
    }
    
    /**
     * Retourne les headers d'authentification pour les requêtes privées
     */
    fun getAuthHeaders() -> Map {
        if (this.currentArl != null) {
            return {
                'Cookie': 'arl=${this.currentArl}; sid=fr'
            };
        }
        return {};
    }
}
