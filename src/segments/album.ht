class AlbumEndpoint {
    var publicClient: HttpClient;
    var privateClient: HttpClient;
    var auth: AuthEndpoint;
    
    construct(this.publicClient, this.privateClient, this.auth) {
        print('💿 Initialisation de l\'endpoint Album');
    }
    
    fun get(id: String) -> Future {
        return Future((resolve, reject) {
            print('💿 Récupération de l\'album ID: ${id}');
            
            final url = '/album/${id}';
            
            this.publicClient.get(url).then((response) {
                if (response.statusCode == 200) {
                    try {
                        final data = response.toJson();
                        final album = this._mapAlbumToSpotube(data);
                        print('✅ Album récupéré: ${album.name} (${album.totalTracks} titres)');
                        resolve(album);
                    } catch (e) {
                        print('❌ Erreur parsing album: ${e}');
                        reject('Erreur lors du parsing de l\'album: ${e}');
                    }
                } else {
                    print('❌ Album non trouvé: ${response.statusCode}');
                    reject('Album non trouvé');
                }
            }).catchError((error) {
                print('❌ Erreur réseau album: ${error}');
                reject(error.toString());
            });
        });
    }
    
    fun getTracks(id: String, offset: number = 0, limit: number = 50) -> Future {
        return Future((resolve, reject) {
            print('🎵 Récupération des titres de l\'album ${id}');
            
            final url = '/album/${id}/tracks?index=${offset}&limit=${limit}';
            
            this.publicClient.get(url).then((response) {
                if (response.statusCode == 200) {
                    try {
                        final data = response.toJson();
                        final tracks = [];
                        
                        if (data.data && data.data.isNotEmpty) {
                            for (track in data.data) {
                                tracks.add(this._mapTrackToSpotube(track, id));
                            }
                        }
                        
                        print('✅ ${tracks.length} titres récupérés pour l\'album ${id}');
                        resolve(tracks);
                    } catch (e) {
                        print('❌ Erreur parsing titres album: ${e}');
                        reject('Erreur lors du parsing des titres: ${e}');
                    }
                } else {
                    print('❌ Titres de l\'album non trouvés: ${response.statusCode}');
                    reject('Titres de l\'album non trouvés');
                }
            }).catchError((error) {
                print('❌ Erreur réseau titres album: ${error}');
                reject(error.toString());
            });
        });
    }
    
    fun _mapAlbumToSpotube(deezerAlbum: Map) -> Map {
        return {
            'id': deezerAlbum.id?.toString() || '0',
            'name': deezerAlbum.title || 'Album inconnu',
            'externalUri': deezerAlbum.link || '',
            'images': deezerAlbum.cover_medium ? [{
                'url': deezerAlbum.cover_small || deezerAlbum.cover_medium,
                'width': 64,
                'height': 64
            }, {
                'url': deezerAlbum.cover_medium,
                'width': 300,
                'height': 300
            }, {
                'url': deezerAlbum.cover_big || deezerAlbum.cover_xl || deezerAlbum.cover_medium,
                'width': 640,
                'height': 640
            }] : [],
            'albumType': deezerAlbum.record_type || 'album',
            'artists': [{
                'id': deezerAlbum.artist?.id?.toString() || '0',
                'name': deezerAlbum.artist?.name || 'Artiste inconnu',
                'externalUri': deezerAlbum.artist?.link || ''
            }],
            'releaseDate': deezerAlbum.release_date || '',
            'releaseDatePrecision': 'day',
            'totalTracks': deezerAlbum.nb_tracks || 0,
            'copyrights': [],
            'genres': deezerAlbum.genres?.data ? deezerAlbum.genres.data.map((genre) => genre.name) : [],
            'label': deezerAlbum.label || '',
            'popularity': deezerAlbum.fans || 0,
            'availableMarkets': ['FR'],
            'externalIds': {}
        };
    }
    
    fun _mapTrackToSpotube(deezerTrack: Map, albumId: String) -> Map {
        return {
            'id': deezerTrack.id?.toString() || '0',
            'name': deezerTrack.title || 'Titre inconnu',
            'externalUri': deezerTrack.link || '',
            'artists': [{
                'id': deezerTrack.artist?.id?.toString() || '0',
                'name': deezerTrack.artist?.name || 'Artiste inconnu',
                'externalUri': deezerTrack.artist?.link || ''
            }],
            'durationMs': (deezerTrack.duration || 0) * 1000,
            'explicit': deezerTrack.explicit_lyrics || false,
            'isrc': deezerTrack.isrc || '',
            'popularity': deezerTrack.rank || 0,
            'previewUrl': deezerTrack.preview || null,
            'discNumber': deezerTrack.disk_number || 1,
            'trackNumber': deezerTrack.track_position || 0,
            'availableMarkets': ['FR'],
            'externalIds': {
                'isrc': deezerTrack.isrc || ''
            },
            'album': {
                'id': albumId
            }
        };
    }
}
